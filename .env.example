# ─── Agents-in-the-air environment configuration ───────────────────────
# Copy to .env and fill in your values. NEVER commit the real .env file.

# ─── App ───
AITA_ENV=development          # development | staging | production
AITA_LOG_LEVEL=INFO
AITA_HOST=0.0.0.0
AITA_PORT=8000

# ─── Paths ───
AITA_DATA_DIR=/tmp/aita/data
AITA_WORKSPACE_DIR=/tmp/aita/workspace

# ─── CORS ───
# Comma-separated list of allowed origins. Use * only in dev.
AITA_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ─── Auth ───
# If set, all /api/* endpoints require this key in the X-API-Key header.
# Leave empty in dev to disable auth. MUST be set in production.
AITA_API_KEY=

# ─── Rate limiting ───
AITA_RATE_LIMIT_ENABLED=true
AITA_RATE_LIMIT_REQUESTS=100
AITA_RATE_LIMIT_WINDOW=60

# ─── Executor ───
AITA_MAX_CONCURRENT_NODES=10
AITA_DEFAULT_NODE_TIMEOUT=120
AITA_MAX_WORKFLOW_NODES=500
AITA_MAX_CODE_OUTPUT_BYTES=1000000

# ─── HTTP node ───
AITA_HTTP_BLOCK_PRIVATE_IPS=true
AITA_HTTP_MAX_REDIRECTS=5
AITA_HTTP_DEFAULT_TIMEOUT=30
# Optional: comma-separated host allowlist (glob), e.g. api.openai.com,api.anthropic.com
# AITA_HTTP_ALLOWED_HOSTS=

# ─── Code sandbox ───
AITA_CODE_SANDBOX_ENABLED=true
AITA_CODE_MAX_CPU_SECONDS=30

# ─── LLM provider API keys (referenced in workflows as ${{env:NAME}}) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
