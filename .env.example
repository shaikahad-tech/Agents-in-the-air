# Copy this file to .env and fill in your API keys.
# These are read at runtime when a workflow references them as ${{env:NAME}}.
# Never commit the real .env file.

# LLM providers (add whichever you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# HTTP node auth (example)
# SLACK_BOT_TOKEN=xoxb-...
# GITHUB_TOKEN=ghp_...

# Server config (optional)
AITA_DATA=/tmp/aita/data
AITA_WORKSPACE=/tmp/aita/workspace
